{
  "name": "family-finance",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply finance-db --local",
    "db:remote": "wrangler d1 migrations apply finance-db --remote",
    "test": "node --test tests/*.test.js",
    "test:integration": "node tests/integration.mjs",
    "check": "node --check src/worker.js && node --check src/auth.js && node --check public/app.js && node --check public/domain.js",
    "build": "wrangler deploy --dry-run --outdir dist",
    "format": "prettier --write public src tests migrations/*.sql README.md package.json wrangler.jsonc --ignore-unknown"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "miniflare": "5.20261019.2-beta",
    "prettier": "^3.9.10",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
