# Only local loopback development accepts this bypass. Production always requires Google.
DEV_AUTH=true
# No Google credentials or SESSION_SECRET are required for local preview.
# To test real Google login locally, set DEV_AUTH=false and configure:
# APP_URL=http://localhost:8787
# GOOGLE_CLIENT_ID=your-client-id
# GOOGLE_CLIENT_SECRET=your-client-secret
# Optional: US latest-price quotes. Keep the real key only in .dev.vars / Cloudflare Secrets.
# FINNHUB_API_KEY=your-finnhub-key
# Optional: Taiwan primary quotes; exchange open data remains the fallback.
# FUGLE_API_KEY=your-fugle-key
